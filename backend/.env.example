# --- Database ---
# Local dev: use a file URL (auto-created in backend/data/)
DATABASE_URL=file:./data/app.db
# Production (Turso): paste your libsql:// URL here and the auth token
# DATABASE_URL=libsql://your-db-xxxxx.turso.io
TURSO_AUTH_TOKEN=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
